; Slime Life — bare minimum native life-sim vertical slice
; Separate project. Never shares Colony Clash files, services, repos, or deployment.
config_version=5

[application]
config/name="Slime Life"
config/version="0.1.0"
config/unique_name="com.slimelife.game"
config/icon="res://assets/icons/slime_life_icon.svg"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/size/resizable=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
textures/default_filters/use_nearest_mipmap_filter=false

[input]
camera_rotate_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":81)]}
camera_rotate_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":69)]}
camera_zoom_in={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":61)]}
camera_zoom_out={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":45)]}
camera_pan_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
camera_pan_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
camera_pan_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
camera_pan_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
